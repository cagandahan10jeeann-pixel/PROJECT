<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <title>ShoeHub - Home</title>

</head>

<body class="bg-gray-100 min-h-screen">

<!-- Customer Navigation Bar -->
<nav class="bg-gray-900 text-white px-6 py-4">

    <div class="flex justify-between items-center">

        <!-- ShoeHub Logo -->
        <a href="/" class="text-xl font-bold">
            👟 SHOEHUB
        </a>

        <!-- Main Navigation -->
        <div class="flex items-center gap-6">

            <!-- Home -->
            <a href="/" class="hover:text-gray-300">
                Home
            </a>

            <!-- Shoes -->
            <a href="/shoes" class="hover:text-gray-300">
                Shoes
            </a>

            <% if (user) { %>

                <!-- Cart -->
                <a href="/cart" class="hover:text-gray-300">
                    Cart
                </a>

                <!-- My Orders -->
                <a href="/orders" class="hover:text-gray-300">
                    My Orders
                </a>

                <!-- Customer Dropdown -->
                <div class="relative">

                    <button
                        type="button"
                        onclick="toggleUserMenu()"
                        class="flex items-center gap-2 hover:text-gray-300"
                    >
                        👤
                        <%= user.first_name %>
                        <span>▼</span>
                    </button>

                    <!-- Dropdown Menu -->
                    <div
                        id="userMenu"
                        class="hidden absolute right-0 mt-3 w-40 bg-white text-gray-800 rounded-lg shadow-lg overflow-hidden z-50"
                    >

                        <!-- My Profile -->
                        <a
                            href="/profile"
                            class="block px-4 py-3 hover:bg-gray-100"
                        >
                            My Profile
                        </a>

                        <!-- Logout -->
                        <a
                            href="/logout"
                            class="block px-4 py-3 hover:bg-gray-100"
                        >
                            Logout
                        </a>

                    </div>

                </div>

            <% } else { %>

                <!-- Login -->
                <a href="/login" class="hover:text-gray-300">
                    Login
                </a>

                <!-- Register -->
                <a href="/register" class="hover:text-gray-300">
                    Register
                </a>

            <% } %>

        </div>

    </div>

</nav>


<!-- Hero Section -->
<section class="bg-white">

    <div class="max-w-7xl mx-auto px-6 py-20 text-center">

        <h1 class="text-5xl font-bold text-gray-900 mb-5">
            Find Your Perfect Shoes
        </h1>

        <p class="text-lg text-gray-600 mb-8">
            Quality shoes for every occasion
        </p>

        <a
            href="/shoes"
            class="inline-block bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700"
        >
            Shop Now
        </a>

    </div>

</section>


<!-- Featured Shoes -->
<section class="max-w-7xl mx-auto px-6 py-12">

    <h2 class="text-3xl font-bold text-gray-800 mb-8">
        Featured Shoes
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        <!-- Featured Shoe 1 -->
        <div class="bg-white rounded-xl shadow p-6">

            <!-- Shoe Image -->
            <div class="h-48 bg-gray-200 rounded-lg overflow-hidden mb-5">

                <img
                    src="/images/products/classic-white-sneakers.jpg"
                    alt="Classic White Sneakers"
                    class="w-full h-full object-cover"
                >

            </div>

            <h3 class="text-xl font-semibold text-gray-800 mb-2">
                Classic White Sneakers
            </h3>

            <p class="text-gray-600 mb-4">
                ₱1,500.00
            </p>

            <a
                href="/shoes"
                class="text-blue-600 hover:underline"
            >
                View Shoes
            </a>

        </div>


        <!-- Featured Shoe 2 -->
        <div class="bg-white rounded-xl shadow p-6">

            <!-- Shoe Image -->
            <div class="h-48 bg-gray-200 rounded-lg overflow-hidden mb-5">

                <img
                    src="/images/products/speed-runner.jpg"
                    alt="Speed Runner"
                    class="w-full h-full object-cover"
                >

            </div>

            <h3 class="text-xl font-semibold text-gray-800 mb-2">
                Speed Runner
            </h3>

            <p class="text-gray-600 mb-4">
                ₱2,000.00
            </p>

            <a
                href="/shoes"
                class="text-blue-600 hover:underline"
            >
                View Shoes
            </a>

        </div>


        <!-- Featured Shoe 3 -->
        <div class="bg-white rounded-xl shadow p-6">

            <!-- Shoe Image -->
            <div class="h-48 bg-gray-200 rounded-lg overflow-hidden mb-5">

                <img
                    src="/images/products/court-pro.jpg"
                    alt="Court Pro"
                    class="w-full h-full object-cover"
                >

            </div>

            <h3 class="text-xl font-semibold text-gray-800 mb-2">
                Court Pro
            </h3>

            <p class="text-gray-600 mb-4">
                ₱2,500.00
            </p>

            <a
                href="/shoes"
                class="text-blue-600 hover:underline"
            >
                View Shoes
            </a>

        </div>

    </div>

</section>


<!-- Customer Dropdown JavaScript -->
<script>

    // Show or hide the customer dropdown menu
    function toggleUserMenu() {

        const menu = document.getElementById("userMenu");

        menu.classList.toggle("hidden");

    }

</script>


</body>

</html>