<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <script src="https://cdn.tailwindcss.com"></script>

    <title>Checkout - ShoeHub</title>

</head>

<body class="bg-stone-100 min-h-screen">

    <!-- Navigation bar -->
    <nav class="bg-stone-900 text-white px-8 py-4">

        <div class="max-w-6xl mx-auto flex justify-between items-center">

            <!-- Logo -->
            <a href="/" class="text-2xl font-bold">
                👟 SHOEHUB
            </a>

            <!-- Navigation links -->
            <div class="flex gap-6">

                <a href="/" class="hover:text-stone-300">
                    Home
                </a>

                <a href="/shoes" class="hover:text-stone-300">
                    Shoes
                </a>

                <a href="/cart" class="hover:text-stone-300">
                    Cart
                </a>

                <a href="/orders" class="hover:text-stone-300">
                    My Orders
                </a>

                <a href="/profile" class="hover:text-stone-300">
                    Profile
                </a>

            </div>

        </div>

    </nav>


    <!-- Checkout content -->
    <main class="max-w-5xl mx-auto px-6 py-10">

        <!-- Page title -->
        <h1 class="text-3xl font-bold text-stone-900 mb-8">
            Checkout
        </h1>


        <div class="grid md:grid-cols-2 gap-8">

            <!-- Customer information -->
            <div class="bg-white rounded-xl shadow p-6">

                <h2 class="text-xl font-bold text-stone-900 mb-6">
                    Delivery Information
                </h2>

                <!-- Checkout form -->
                <form action="/checkout" method="POST">

                    <!-- Name -->
                    <label class="block text-sm font-medium text-stone-700 mb-2">
                        Name
                    </label>

                    <input
                        type="text"
                        name="name"
                        required
                        class="w-full border border-stone-300 rounded-lg px-4 py-3 mb-5 focus:outline-none focus:ring-2 focus:ring-stone-500"
                        placeholder="Enter your full name"
                    >


                    <!-- Email -->
                    <label class="block text-sm font-medium text-stone-700 mb-2">
                        Email
                    </label>

                    <input
                        type="email"
                        name="email"
                        required
                        class="w-full border border-stone-300 rounded-lg px-4 py-3 mb-5 focus:outline-none focus:ring-2 focus:ring-stone-500"
                        placeholder="Enter your email"
                    >


                    <!-- Delivery address -->
                    <label class="block text-sm font-medium text-stone-700 mb-2">
                        Delivery Address
                    </label>

                    <textarea
                        name="address"
                        rows="4"
                        required
                        class="w-full border border-stone-300 rounded-lg px-4 py-3 mb-6 focus:outline-none focus:ring-2 focus:ring-stone-500"
                        placeholder="Enter your complete delivery address"
                    ></textarea>


                    <!-- Place order button -->
                    <button
                        type="submit"
                        class="w-full bg-stone-900 text-white py-3 rounded-lg font-semibold hover:bg-stone-700"
                    >
                        Place Order
                    </button>

                </form>

            </div>


            <!-- Order summary -->
            <div class="bg-white rounded-xl shadow p-6">

                <h2 class="text-xl font-bold text-stone-900 mb-6">
                    Order Summary
                </h2>


                <!-- Cart items -->
                <div class="space-y-5">

                    <% cartItems.forEach(item => { %>

                        <div class="border-b border-stone-200 pb-4">

                            <div class="flex justify-between gap-4">

                                <div>

                                    <h3 class="font-semibold text-stone-900">
                                        <%= item.name %>
                                    </h3>

                                    <p class="text-sm text-stone-500">
                                        Color: <%= item.color %>
                                    </p>

                                    <p class="text-sm text-stone-500">
                                        Size: <%= item.size %>
                                    </p>

                                    <p class="text-sm text-stone-500">
                                        Quantity: <%= item.quantity %>
                                    </p>

                                </div>

                                <p class="font-semibold text-stone-900">
                                    ₱<%= (item.price * item.quantity).toLocaleString("en-PH", {
                                        minimumFractionDigits: 2
                                    }) %>
                                </p>

                            </div>

                        </div>

                    <% }) %>

                </div>


                <!-- Total -->
                <div class="flex justify-between items-center mt-6 pt-5 border-t border-stone-300">

                    <span class="text-xl font-bold text-stone-900">
                        Total
                    </span>

                    <span class="text-2xl font-bold text-stone-900">
                        ₱<%= total.toLocaleString("en-PH", {
                            minimumFractionDigits: 2
                        }) %>
                    </span>

                </div>

            </div>

        </div>

    </main>

</body>

</html>