<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <title>Edit Profile - ShoeHub</title>

</head>

<body class="bg-gray-100 min-h-screen">

    <!-- ============================== -->
    <!-- Customer Navigation Bar -->
    <!-- ============================== -->

    <nav class="bg-gray-900 text-white px-6 py-4">

        <div class="flex justify-between items-center">

            <!-- ShoeHub Logo -->
            <a href="/" class="text-xl font-bold">
                👟 SHOEHUB
            </a>

            <!-- Main Navigation -->
            <div class="flex items-center gap-6">

                <!-- Home -->
                <a
                    href="/"
                    class="hover:text-gray-300"
                >
                    Home
                </a>

                <!-- Shoes -->
                <a
                    href="/shoes"
                    class="hover:text-gray-300"
                >
                    Shoes
                </a>

                <!-- Cart -->
                <a
                    href="/cart"
                    class="hover:text-gray-300"
                >
                    Cart
                </a>

                <!-- My Orders -->
                <a
                    href="/orders"
                    class="hover:text-gray-300"
                >
                    My Orders
                </a>

                <!-- Customer Dropdown -->
                <div class="relative">

                    <button
                        type="button"
                        onclick="toggleUserMenu()"
                        class="flex items-center gap-2 hover:text-gray-300"
                    >
                        👤
                        <%= user.first_name %>
                        <span>▼</span>
                    </button>

                    <!-- Dropdown Menu -->
                    <div
                        id="userMenu"
                        class="hidden absolute right-0 mt-3 w-40 bg-white text-gray-800 rounded-lg shadow-lg overflow-hidden z-50"
                    >

                        <!-- My Profile -->
                        <a
                            href="/profile"
                            class="block px-4 py-3 hover:bg-gray-100"
                        >
                            My Profile
                        </a>

                        <!-- Logout -->
                        <a
                            href="/logout"
                            class="block px-4 py-3 hover:bg-gray-100"
                        >
                            Logout
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </nav>


    <!-- ============================== -->
    <!-- Edit Profile Section -->
    <!-- ============================== -->

    <div class="max-w-2xl mx-auto px-6 py-10">

        <!-- Page Title -->
        <h1 class="text-3xl font-bold text-gray-800 mb-8">
            Edit Profile
        </h1>


        <!-- Edit Profile Form -->
        <form
            action="/profile/edit"
            method="POST"
            class="bg-white rounded-xl shadow p-8"
        >

            <!-- First Name -->
            <div class="mb-5">

                <label
                    for="first_name"
                    class="block text-sm font-medium text-gray-700 mb-2"
                >
                    First Name
                </label>

                <input
                    type="text"
                    id="first_name"
                    name="first_name"
                    value="<%= user.first_name %>"
                    required
                    class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500"
                >

            </div>


            <!-- Last Name -->
            <div class="mb-5">

                <label
                    for="last_name"
                    class="block text-sm font-medium text-gray-700 mb-2"
                >
                    Last Name
                </label>

                <input
                    type="text"
                    id="last_name"
                    name="last_name"
                    value="<%= user.last_name %>"
                    required
                    class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500"
                >

            </div>


            <!-- Email -->
            <div class="mb-5">

                <label
                    for="email"
                    class="block text-sm font-medium text-gray-700 mb-2"
                >
                    Email
                </label>

                <input
                    type="email"
                    id="email"
                    name="email"
                    value="<%= user.email %>"
                    required
                    class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500"
                >

            </div>


            <!-- Role -->
            <div class="mb-8">

                <label
                    class="block text-sm font-medium text-gray-700 mb-2"
                >
                    Role
                </label>

                <!-- Role cannot be edited -->
                <div
                    class="w-full border border-gray-300 rounded-lg px-4 py-3 bg-gray-50 text-gray-700"
                >
                    Customer
                </div>

            </div>


            <!-- Buttons -->
            <div class="flex items-center gap-4">

                <!-- Cancel -->
                <a
                    href="/profile"
                    class="text-gray-600 hover:underline"
                >
                    Cancel
                </a>

                <!-- Save Changes -->
                <button
                    type="submit"
                    class="bg-blue-600 text-white px-5 py-3 rounded-lg hover:bg-blue-700"
                >
                    Save Changes
                </button>

            </div>

        </form>

    </div>


    <!-- ============================== -->
    <!-- Customer Dropdown JavaScript -->
    <!-- ============================== -->

    <script>

        // Show or hide the customer dropdown menu
        function toggleUserMenu() {

            const menu = document.getElementById("userMenu");

            menu.classList.toggle("hidden");

        }

    </script>

</body>

</html>