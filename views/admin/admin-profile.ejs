<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <title>Edit Admin Profile - ShoeHub</title>

</head>

<body class="bg-gray-100 min-h-screen">

    <!-- ============================== -->
    <!-- Admin Navigation -->
    <!-- ============================== -->

    <nav class="bg-gray-900 text-white px-6 py-4">

        <div class="max-w-7xl mx-auto flex justify-between items-center">

            <!-- ShoeHub Logo -->
            <a href="/admin/dashboard" class="text-xl font-bold">
                👟 SHOEHUB
            </a>

            <!-- Navigation Links -->
            <div class="flex items-center gap-6">

                <a href="/admin/dashboard" class="hover:text-gray-300">
                    Dashboard
                </a>

                <a href="/admin/products" class="hover:text-gray-300">
                    Products
                </a>

                <a href="/admin/orders" class="hover:text-gray-300">
                    Orders
                </a>

                <!-- Admin Dropdown -->
                <div class="relative">

                    <button
                        onclick="toggleAdminMenu()"
                        class="hover:text-gray-300">

                        👤 Admin ▼

                    </button>

                    <!-- Dropdown Menu -->
                    <div
                        id="adminMenu"
                        class="hidden absolute right-0 mt-2 w-40 bg-white text-gray-800 rounded-lg shadow-lg">

                        <a
                            href="/admin/profile"
                            class="block px-4 py-2 hover:bg-gray-100">

                            My Profile

                        </a>

                        <a
                            href="/admin/logout"
                            class="block px-4 py-2 hover:bg-gray-100">

                            Logout

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </nav>


    <!-- ============================== -->
    <!-- Edit Admin Profile -->
    <!-- ============================== -->

    <main class="max-w-3xl mx-auto px-6 py-10">

        <h1 class="text-2xl font-bold text-gray-800">
            Edit Profile
        </h1>

        <p class="text-gray-500 mt-1 mb-6">
            Update your administrator account
        </p>


        <!-- Profile Form -->
        <div class="bg-white rounded-xl shadow-sm p-6">

            <form
                action="/admin/profile/edit"
                method="POST"
                class="space-y-5">

                <!-- First Name -->
                <div>

                    <label
                        for="first_name"
                        class="block text-sm font-medium text-gray-700 mb-1">

                        First Name

                    </label>

                    <input
                        type="text"
                        id="first_name"
                        name="first_name"
                        value="<%= admin.first_name %>"
                        required
                        class="w-full border border-gray-300 rounded-lg px-3 py-2">

                </div>


                <!-- Last Name -->
                <div>

                    <label
                        for="last_name"
                        class="block text-sm font-medium text-gray-700 mb-1">

                        Last Name

                    </label>

                    <input
                        type="text"
                        id="last_name"
                        name="last_name"
                        value="<%= admin.last_name %>"
                        required
                        class="w-full border border-gray-300 rounded-lg px-3 py-2">

                </div>


                <!-- Email -->
                <div>

                    <label
                        for="email"
                        class="block text-sm font-medium text-gray-700 mb-1">

                        Email

                    </label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        value="<%= admin.email %>"
                        required
                        class="w-full border border-gray-300 rounded-lg px-3 py-2">

                </div>


                <!-- Role -->
                <div>

                    <label
                        class="block text-sm font-medium text-gray-700 mb-1">

                        Role

                    </label>

                    <input
                        type="text"
                        value="Administrator"
                        readonly
                        class="w-full bg-gray-100 border border-gray-300 rounded-lg px-3 py-2 text-gray-500">

                </div>


                <!-- Buttons -->
                <div class="flex gap-3 pt-2">

                    <!-- Save Changes -->
                    <button
                        type="submit"
                        class="bg-gray-900 text-white px-5 py-2 rounded-lg hover:bg-gray-800">

                        Save Changes

                    </button>

                    <!-- Cancel -->
                    <a
                        href="/admin/profile"
                        class="border border-gray-300 px-5 py-2 rounded-lg hover:bg-gray-100">

                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </main>


    <!-- ============================== -->
    <!-- JavaScript -->
    <!-- ============================== -->

    <script>

        // Show or hide the admin dropdown
        function toggleAdminMenu() {

            const menu = document.getElementById("adminMenu");

            menu.classList.toggle("hidden");

        }

    </script>

</body>

</html>