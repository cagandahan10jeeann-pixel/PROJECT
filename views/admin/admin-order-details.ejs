<!DOCTYPE html>
<html lang="en">

<head>

    <!-- Page Settings -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Page Title -->
    <title>Order Details - ShoeHub</title>

</head>

<body class="bg-gray-100 min-h-screen">


    <!-- ========================================
         Admin Navigation Bar
    ========================================= -->
    <nav class="bg-gray-900 text-white px-6 py-4">

        <div class="flex justify-between items-center">

            <!-- ShoeHub Logo -->
            <a href="/admin/dashboard" class="text-xl font-bold">
                👟 SHOEHUB
            </a>

            <!-- Main Navigation -->
            <div class="flex items-center gap-6">

                <a
                    href="/admin/dashboard"
                    class="hover:text-gray-300"
                >
                    Dashboard
                </a>

                <a
                    href="/admin/products"
                    class="hover:text-gray-300"
                >
                    Products
                </a>

                <a
                    href="/admin/orders"
                    class="hover:text-gray-300"
                >
                    Orders
                </a>

                <!-- Admin Dropdown -->
                <div class="relative">

                    <button
                        type="button"
                        onclick="toggleAdminMenu()"
                        class="flex items-center gap-2 hover:text-gray-300"
                    >
                        👤 Admin
                        <span>▼</span>
                    </button>

                    <!-- Dropdown Menu -->
                    <div
                        id="adminMenu"
                        class="hidden absolute right-0 mt-3 w-40 bg-white text-gray-800 rounded-lg shadow-lg overflow-hidden z-50"
                    >

                        <a
                            href="/admin/profile"
                            class="block px-4 py-3 hover:bg-gray-100"
                        >
                            My Profile
                        </a>

                        <a
                            href="/admin/logout"
                            class="block px-4 py-3 hover:bg-gray-100"
                        >
                            Logout
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </nav>


    <!-- ========================================
         Main Content
    ========================================= -->
    <div class="max-w-5xl mx-auto px-6 py-8">


        <!-- Page Heading -->
        <div class="mb-6">

            <h1 class="text-2xl font-bold text-gray-800">
                Order #<%= order.id %>
            </h1>

            <p class="text-gray-500 mt-1">
                View order information and update the order status.
            </p>

        </div>


        <!-- ========================================
             Customer Information
        ========================================= -->
        <div class="bg-white rounded-lg shadow p-6 mb-5">

            <h2 class="text-lg font-bold text-gray-800 mb-4">
                Customer Information
            </h2>

            <!-- Customer Information Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

                <!-- Customer Name -->
                <div>

                    <p class="text-sm text-gray-500">
                        Customer Name
                    </p>

                    <p class="font-medium text-gray-800">
                        <%= order.name %>
                    </p>

                </div>


                <!-- Email -->
                <div>

                    <p class="text-sm text-gray-500">
                        Email
                    </p>

                    <p class="font-medium text-gray-800">
                        <%= order.email %>
                    </p>

                </div>


                <!-- Delivery Address -->
                <div>

                    <p class="text-sm text-gray-500">
                        Delivery Address
                    </p>

                    <p class="font-medium text-gray-800">
                        <%= order.delivery_address %>
                    </p>

                </div>


                <!-- Order Date -->
                <div>

                    <p class="text-sm text-gray-500">
                        Order Date
                    </p>

                    <p class="font-medium text-gray-800">
                        <%= new Date(order.created_at).toLocaleString() %>
                    </p>

                </div>

            </div>

        </div>


        <!-- ========================================
             Order Status
        ========================================= -->
        <div class="bg-white rounded-lg shadow p-6 mb-5">

            <h2 class="text-lg font-bold text-gray-800 mb-4">
                Order Status
            </h2>

            <!-- Status Update Form -->
            <form
                action="/admin/orders/<%= order.id %>/status"
                method="POST"
                class="flex flex-col sm:flex-row gap-3"
            >

                <!-- Status Dropdown -->
                <select
                    name="status"
                    class="border border-gray-300 rounded-lg px-4 py-3 sm:w-64"
                >

                    <!-- Pending -->
                    <option
                        value="Pending"
                        <%= order.status === "Pending" ? "selected" : "" %>
                    >
                        Pending
                    </option>

                    <!-- Processing -->
                    <option
                        value="Processing"
                        <%= order.status === "Processing" ? "selected" : "" %>
                    >
                        Processing
                    </option>

                    <!-- Shipped -->
                    <option
                        value="Shipped"
                        <%= order.status === "Shipped" ? "selected" : "" %>
                    >
                        Shipped
                    </option>

                    <!-- Completed -->
                    <option
                        value="Completed"
                        <%= order.status === "Completed" ? "selected" : "" %>
                    >
                        Completed
                    </option>

                    <!-- Cancelled -->
                    <option
                        value="Cancelled"
                        <%= order.status === "Cancelled" ? "selected" : "" %>
                    >
                        Cancelled
                    </option>

                </select>


                <!-- Update Button -->
                <button
                    type="submit"
                    class="bg-gray-900 text-white px-5 py-3 rounded-lg hover:bg-gray-800"
                >
                    Update Status
                </button>

            </form>

        </div>


        <!-- ========================================
             Order Items
        ========================================= -->
        <div class="bg-white rounded-lg shadow p-6 mb-5">

            <h2 class="text-lg font-bold text-gray-800 mb-4">
                Order Items
            </h2>


            <!-- Items Table -->
            <div class="overflow-x-auto">

                <table class="w-full">

                    <!-- Table Header -->
                    <thead>

                        <tr class="border-b text-left text-sm text-gray-500">

                            <th class="py-3 pr-4">
                                Shoe
                            </th>

                            <th class="py-3 pr-4">
                                Color
                            </th>

                            <th class="py-3 pr-4">
                                Size
                            </th>

                            <th class="py-3 pr-4">
                                Price
                            </th>

                            <th class="py-3 pr-4">
                                Quantity
                            </th>

                            <th class="py-3">
                                Subtotal
                            </th>

                        </tr>

                    </thead>


                    <!-- Table Body -->
                    <tbody>

                        <% items.forEach(item => { %>

                            <tr class="border-b last:border-0">

                                <!-- Shoe Name -->
                                <td class="py-4 pr-4 font-medium text-gray-800">
                                    <%= item.name %>
                                </td>

                                <!-- Color -->
                                <td class="py-4 pr-4 text-gray-600">
                                    <%= item.color %>
                                </td>

                                <!-- Size -->
                                <td class="py-4 pr-4 text-gray-600">
                                    <%= item.size %>
                                </td>

                                <!-- Price -->
                                <td class="py-4 pr-4 text-gray-600">
                                    ₱<%= Number(item.price).toLocaleString("en-PH", {
                                        minimumFractionDigits: 2
                                    }) %>
                                </td>

                                <!-- Quantity -->
                                <td class="py-4 pr-4 text-gray-600">
                                    <%= item.quantity %>
                                </td>

                                <!-- Subtotal -->
                                <td class="py-4 font-semibold text-gray-800">

                                    ₱<%= (
                                        Number(item.price) * Number(item.quantity)
                                    ).toLocaleString("en-PH", {
                                        minimumFractionDigits: 2
                                    }) %>

                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            </div>

        </div>


        <!-- ========================================
             Order Total
        ========================================= -->
        <div class="bg-white rounded-lg shadow p-6">

            <div class="flex justify-between items-center">

                <span class="text-lg font-bold text-gray-800">
                    Total
                </span>

                <span class="text-2xl font-bold text-gray-900">
                    ₱<%= Number(order.total).toLocaleString("en-PH", {
                        minimumFractionDigits: 2
                    }) %>
                </span>

            </div>

        </div>

    </div>


    <!-- ========================================
         Admin Dropdown JavaScript
    ========================================= -->
    <script>

        // Show or hide the admin dropdown menu
        function toggleAdminMenu() {

            const menu = document.getElementById("adminMenu");

            menu.classList.toggle("hidden");

        }

    </script>

</body>

</html>