<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <title>Manage Categories - ShoeHub</title>

</head>

<body class="bg-gray-100">


    <!-- Admin navigation -->
    <nav class="bg-gray-900 text-white px-6 py-4">

        <div class="max-w-7xl mx-auto flex justify-between items-center">

            <!-- ShoeHub logo -->
            <a href="/admin/dashboard" class="text-xl font-bold">
                👟 SHOEHUB
            </a>


            <!-- Admin navigation links -->
            <div class="flex gap-6">

                <a href="/admin/dashboard" class="hover:text-gray-300">
                    Dashboard
                </a>

                <a href="/admin/products" class="hover:text-gray-300">
                    Products
                </a>

                <a href="/admin/orders" class="hover:text-gray-300">
                    Orders
                </a>

                <a href="/admin/profile" class="hover:text-gray-300">
                    Profile
                </a>

            </div>

        </div>

    </nav>


    <!-- Main content -->
    <main class="max-w-5xl mx-auto px-6 py-8">


        <!-- Page header -->
        <div class="flex justify-between items-center mb-6">

            <div>

                <h1 class="text-3xl font-bold text-gray-800">
                    Categories
                </h1>

                <p class="text-gray-500 mt-1">
                    Manage ShoeHub product categories
                </p>

            </div>


            <!-- Add category button -->
            <button
                onclick="openAddModal()"
                class="bg-gray-900 text-white px-5 py-2 rounded-lg hover:bg-gray-800"
            >
                + Add Category
            </button>

        </div>


        <!-- Category table -->
        <div class="bg-white rounded-xl shadow overflow-hidden">

            <table class="w-full">

                <thead class="bg-gray-900 text-white">

                    <tr>

                        <th class="text-left px-6 py-4">
                            ID
                        </th>

                        <th class="text-left px-6 py-4">
                            Category Name
                        </th>

                        <th class="text-left px-6 py-4">
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody>

                    <% categories.forEach(category => { %>

                        <tr class="border-b">

                            <td class="px-6 py-4">
                                <%= category.id %>
                            </td>

                            <td class="px-6 py-4 font-medium">
                                <%= category.name %>
                            </td>

                            <td class="px-6 py-4">

                                <div class="flex gap-2">

                                    <!-- Edit -->
                                    <button
                                        onclick="openEditModal(<%= category.id %>, '<%= category.name %>')"
                                        class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700"
                                    >
                                        Edit
                                    </button>


                                    <!-- Delete -->
                                    <form
                                        action="/admin/categories/delete/<%= category.id %>"
                                        method="POST"
                                        onsubmit="return confirm('Are you sure you want to delete this category?')"
                                    >

                                        <button
                                            type="submit"
                                            class="bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700"
                                        >
                                            Delete
                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>

                    <% }) %>

                </tbody>

            </table>

        </div>

    </main>


    <!-- Add Category Modal -->
    <div
        id="addModal"
        class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center"
    >

        <div class="bg-white w-full max-w-md rounded-xl shadow-lg p-6">

            <h2 class="text-2xl font-bold mb-4">
                Add New Category
            </h2>


            <form
                action="/admin/categories/create"
                method="POST"
            >

                <label class="block font-semibold mb-2">
                    Category Name
                </label>

                <input
                    type="text"
                    name="name"
                    required
                    class="w-full border rounded-lg px-4 py-2 mb-6"
                    placeholder="Enter category name"
                >


                <div class="flex justify-end gap-3">

                    <button
                        type="button"
                        onclick="closeAddModal()"
                        class="bg-gray-200 px-5 py-2 rounded-lg"
                    >
                        Cancel
                    </button>

                    <button
                        type="submit"
                        class="bg-gray-900 text-white px-5 py-2 rounded-lg"
                    >
                        Add Category
                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- Edit Category Modal -->
    <div
        id="editModal"
        class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center"
    >

        <div class="bg-white w-full max-w-md rounded-xl shadow-lg p-6">

            <h2 class="text-2xl font-bold mb-4">
                Edit Category
            </h2>


            <form id="editForm" method="POST">

                <label class="block font-semibold mb-2">
                    Category Name
                </label>

                <input
                    type="text"
                    id="editCategoryName"
                    name="name"
                    required
                    class="w-full border rounded-lg px-4 py-2 mb-6"
                >


                <div class="flex justify-end gap-3">

                    <button
                        type="button"
                        onclick="closeEditModal()"
                        class="bg-gray-200 px-5 py-2 rounded-lg"
                    >
                        Cancel
                    </button>

                    <button
                        type="submit"
                        class="bg-gray-900 text-white px-5 py-2 rounded-lg"
                    >
                        Save Changes
                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- JavaScript -->
    <script>

        // Open Add Category modal
        function openAddModal() {

            document
                .getElementById("addModal")
                .classList.remove("hidden");

        }


        // Close Add Category modal
        function closeAddModal() {

            document
                .getElementById("addModal")
                .classList.add("hidden");

        }


        // Open Edit Category modal
        function openEditModal(id, name) {

            document
                .getElementById("editModal")
                .classList.remove("hidden");

            document
                .getElementById("editCategoryName")
                .value = name;

            document
                .getElementById("editForm")
                .action = "/admin/categories/edit/" + id;

        }


        // Close Edit Category modal
        function closeEditModal() {

            document
                .getElementById("editModal")
                .classList.add("hidden");

        }

    </script>


</body>

</html>