<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <title>Admin Login - ShoeHub</title>
</head>

<body class="bg-stone-100 min-h-screen flex items-center justify-center">

    <!-- Admin login container -->
    <div class="w-full max-w-md bg-white rounded-xl shadow-lg p-8">

        <!-- ShoeHub title -->
        <div class="text-center mb-8">

            <h1 class="text-3xl font-bold text-stone-900">
                👟 SHOEHUB
            </h1>

            <p class="text-stone-500 mt-2">
                Admin Login
            </p>

        </div>

        <!-- Admin login form -->
        <form action="/admin/login" method="POST">

            <!-- Email -->
            <label class="block text-sm font-medium text-stone-700 mb-2">
                Email
            </label>

            <input
                type="email"
                name="email"
                required
                class="w-full border border-stone-300 rounded-lg px-4 py-3 mb-5"
                placeholder="Enter admin email"
            >

            <!-- Password -->
            <label class="block text-sm font-medium text-stone-700 mb-2">
                Password
            </label>

            <input
                type="password"
                name="password"
                required
                class="w-full border border-stone-300 rounded-lg px-4 py-3 mb-6"
                placeholder="Enter admin password"
            >

            <!-- Login button -->
            <button
                type="submit"
                class="w-full bg-stone-900 text-white py-3 rounded-lg font-semibold"
            >
                Login
            </button>

        </form>

        <!-- Back to customer login -->
        <div class="text-center mt-6">

            <a
                href="/login"
                class="text-stone-600"
            >
                Back to Customer Login
            </a>

        </div>

    </div>

</body>

</html>