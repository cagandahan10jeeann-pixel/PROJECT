<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <title>Edit Shoe - ShoeHub</title>

</head>

<body class="bg-gray-100">

    <!-- ========================================
         Admin Navigation Bar
    ========================================= -->
    <nav class="bg-gray-900 text-white px-6 py-4">

        <div class="flex justify-between items-center">

            <!-- ShoeHub Logo -->
            <a href="/admin/dashboard" class="text-xl font-bold">
                👟 SHOEHUB
            </a>

            <!-- Navigation Links -->
            <div class="flex items-center gap-6">

                <a
                    href="/admin/dashboard"
                    class="hover:text-gray-300"
                >
                    Dashboard
                </a>

                <a
                    href="/admin/products"
                    class="hover:text-gray-300"
                >
                    Products
                </a>

                <a
                    href="/admin/orders"
                    class="hover:text-gray-300"
                >
                    Orders
                </a>

                <!-- Admin Dropdown -->
                <div class="relative">

                    <button
                        type="button"
                        onclick="toggleAdminMenu()"
                        class="flex items-center gap-2 hover:text-gray-300"
                    >
                        👤 Admin
                        <span>▼</span>
                    </button>

                    <!-- Dropdown Menu -->
                    <div
                        id="adminMenu"
                        class="hidden absolute right-0 mt-3 w-40 bg-white text-gray-800 rounded-lg shadow-lg overflow-hidden"
                    >

                        <a
                            href="/admin/profile"
                            class="block px-4 py-3 hover:bg-gray-100"
                        >
                            My Profile
                        </a>

                        <a
                            href="/admin/logout"
                            class="block px-4 py-3 hover:bg-gray-100"
                        >
                            Logout
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </nav>


    <!-- ========================================
         Main Content
    ========================================= -->
    <div class="max-w-4xl mx-auto px-6 py-8">

        <!-- Edit Shoe Card -->
        <div class="bg-white rounded-lg shadow p-6">

            <!-- Page Title -->
            <h1 class="text-2xl font-bold text-gray-800 mb-1">
                Edit Shoe
            </h1>

            <p class="text-gray-500 mb-6">
                Edit this shoe variant.
            </p>


            <!-- ========================================
                 Edit Shoe Form
            ========================================= -->
            <form
                action="/admin/products/edit/<%= product.variant_id %>"
                method="POST"
            >

                <!-- Shoe Name -->
                <div class="mb-5">

                    <label class="block text-gray-700 font-medium mb-2">
                        Shoe Name
                    </label>

                    <input
                        type="text"
                        name="name"
                        value="<%= product.name %>"
                        required
                        class="w-full border rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-gray-400"
                    >

                </div>


                <!-- Category -->
                <div class="mb-5">

                    <label class="block text-gray-700 font-medium mb-2">
                        Category
                    </label>

                    <select
                        name="category_id"
                        required
                        class="w-full border rounded-lg px-4 py-3"
                    >

                        <% categories.forEach(category => { %>

                            <option
                                value="<%= category.id %>"
                                <%= category.id == product.category_id ? "selected" : "" %>
                            >
                                <%= category.name %>
                            </option>

                        <% }) %>

                    </select>

                </div>


                <!-- ========================================
                     Price / Stock / Color / Size
                     Four fields in one row
                ========================================= -->
                <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-5">

                    <!-- Price -->
                    <div>

                        <label class="block text-gray-700 font-medium mb-2">
                            Price
                        </label>

                        <input
                            type="number"
                            name="price"
                            value="<%= product.variant_price %>"
                            min="0"
                            step="0.01"
                            required
                            class="w-full border rounded-lg px-4 py-3"
                        >

                    </div>


                    <!-- Stock -->
                    <div>

                        <label class="block text-gray-700 font-medium mb-2">
                            Stock
                        </label>

                        <input
                            type="number"
                            name="stock"
                            value="<%= product.variant_stock %>"
                            min="0"
                            required
                            class="w-full border rounded-lg px-4 py-3"
                        >

                    </div>


                    <!-- Color -->
                    <div>

                        <label class="block text-gray-700 font-medium mb-2">
                            Color
                        </label>

                        <input
                            type="text"
                            name="color"
                            value="<%= product.variant_color %>"
                            required
                            class="w-full border rounded-lg px-4 py-3"
                        >

                    </div>


                    <!-- Size -->
                    <div>

                        <label class="block text-gray-700 font-medium mb-2">
                            Size
                        </label>

                        <input
                            type="text"
                            name="size"
                            value="<%= product.variant_size %>"
                            required
                            class="w-full border rounded-lg px-4 py-3"
                        >

                    </div>

                </div>


                <!-- Description -->
                <div class="mb-6">

                    <label class="block text-gray-700 font-medium mb-2">
                        Description
                    </label>

                    <textarea
                        name="description"
                        rows="4"
                        class="w-full border rounded-lg px-4 py-3"
                    ><%= product.description || "" %></textarea>

                </div>


                <!-- ========================================
                     Buttons
                ========================================= -->
                <div class="flex gap-3">

                    <!-- Cancel -->
                    <a
                        href="/admin/products"
                        class="bg-gray-200 text-gray-700 px-5 py-3 rounded-lg hover:bg-gray-300"
                    >
                        Cancel
                    </a>

                    <!-- Save Changes -->
                    <button
                        type="submit"
                        class="bg-gray-900 text-white px-5 py-3 rounded-lg hover:bg-gray-800"
                    >
                        Save Changes
                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- ========================================
         Admin Dropdown JavaScript
    ========================================= -->
    <script>

        // Show or hide the admin dropdown menu
        function toggleAdminMenu() {

            const menu = document.getElementById("adminMenu");

            menu.classList.toggle("hidden");

        }

    </script>

</body>

</html>